# ─── Copy this file to .env and fill in your values ─────────────────────────
# NEVER commit the real .env file to version control.

# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
# Async URL for FastAPI (asyncpg driver — use ?ssl=require for Neon)
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?ssl=require

# Sync URL for Alembic migrations (psycopg2 driver)
SYNC_DATABASE_URL=postgresql+psycopg2://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb

# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME=School Management System
DEBUG=False
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Generate a secure secret key with: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_32_CHARS_MINIMUM
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── RSA Encryption Keys (CNIC / B-Form) ─────────────────────────────────────
# Generate a new key pair with:
#   python -c "from app.encryption import generate_rsa_key_pair; priv, pub = generate_rsa_key_pair(); print('PRIVATE:'); print(priv); print('PUBLIC:'); print(pub)"
RSA_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nPASTE_YOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----"
RSA_PUBLIC_KEY="-----BEGIN RSA PUBLIC KEY-----\nPASTE_YOUR_KEY_HERE\n-----END RSA PUBLIC KEY-----"
